# ---------------------------------------------------------------------------
# Stellar network configuration (issue #204)
# ---------------------------------------------------------------------------
# ONE source of truth for Horizon reads AND wallet-kit signing.
# The network used for balance reads MUST equal the network used for signing.

# Which Stellar network. REQUIRED in production.
# - "testnet"  -> passphrase "Test SDF Network ; September 2015"
# - "mainnet"  -> passphrase "Public Global Stellar Network ; September 2015"
# (The full passphrase string is also accepted here, e.g. the production
#  passphrase above, and is normalized to "mainnet".)
NEXT_PUBLIC_STELLAR_NETWORK=

# Horizon URL for the chosen network. Must match NEXT_PUBLIC_STELLAR_NETWORK.
# testnet : https://horizon-testnet.stellar.org
# mainnet : https://horizon-mainnet.stellar.org
NEXT_PUBLIC_STELLAR_HORIZON_URL=

# Optional. Explorer shown in non-production network badges / links.
# testnet : https://stellarexpert.com
# mainnet : https://stellar.expert
NEXT_PUBLIC_STELLAR_EXPLORER_URL=

# Existing app config (unchanged):
NEXT_PUBLIC_API_BASE_URL=
